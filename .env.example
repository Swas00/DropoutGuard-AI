# ===================================================
# DropoutGuard AI - Global Environment Variables
# Copy to .env for Docker Compose overrides
# ===================================================

# JWT Encryption Secret
JWT_SECRET=dropoutguard-secure-enterprise-jwt-key-2026-prod

# Database connection
MONGODB_URI=mongodb://mongo:27017/dropoutguard

# Machine Learning Service URL
ML_API_URL=http://ml:5001

# Optional Google Gemini API Key
# GEMINI_API_KEY=your-gemini-api-key-here
