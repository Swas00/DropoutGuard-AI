# ===================================================
# DropoutGuard AI Backend - Environment Configuration
# ===================================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# JSON Web Token Secret (replace with a secure random 64-char string in production)
JWT_SECRET=dropoutguard-secure-enterprise-jwt-key-2026-prod

# Machine Learning FastAPI Microservice URL
# Local dev: http://127.0.0.1:5001
# Docker Compose: http://ml:5001
ML_API_URL=http://ml:5001

# MongoDB Connection String
# Local dev: mongodb://localhost:27017/dropoutguard
# Docker Compose: mongodb://mongo:27017/dropoutguard
# MongoDB Atlas Cloud: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/dropoutguard?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/dropoutguard

# Set to 'true' if running without MongoDB (falls back to calibrated in-memory JSON datastore)
SKIP_MONGO=false

# Optional Google Gemini API Key (for LLM clinical recommendation synthesis)
# GEMINI_API_KEY=your-gemini-api-key-here
